# MES50HP UART0_RX (hardware manual): R8, Bank 2, 3.3 V.
define_attribute {p:uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx} {PAP_IO_LOC} {R8}
define_attribute {p:uart_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
# MES50HP UART0_TX: R9. Status telemetry, 115200 8N1.
define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {R9}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {4}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
# MES50HP hardware manual section3.4.1/table3-8: KEY1, active low.
# The physical switch has a board pull-up and is synchronized/debounced in RTL.
define_attribute {p:geometry_key_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:geometry_key_n} {PAP_IO_LOC} {K18}
define_attribute {p:geometry_key_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:geometry_key_n} {PAP_IO_STANDARD} {LVCMOS33}
# DVP input delays require measured/module timing information.
# This file is an initial constraint set, NOT timing-signoff evidence.
# PDS native CDC bus-skew assertions (User Guide 6.4.1, p198).
# Each independent bus/direction has its own assertion. Only source
# Gray register -> FIRST destination synchronizer stage is selected.
# Bundled mailboxes hold payload until acknowledgement; each group
# includes request -> sync1 AND held payload -> destination capture.
# 5 ns is half the shortest 10 ns core clock; camera is >=11.90 ns
# and pixel is >=13.46 ns. This leaves margin without a 2 ns overconstraint.
# set_max_skew remains effective under the asynchronous clock groups.
# syn_preserve prevents Gray MSBs merging into binary pointer registers.
# Max Skew Report must show these paths after routing before sign-off.
# CDC_GRAY raw_frames: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^raw_frame_stats/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^raw_frame_stats/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY display_underflow: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/display_stats/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/display_stats/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY capture_overflow: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/overflow_stats/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/overflow_stats/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY capture_fifo_write: 12 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/fifo/wg\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/fifo/wg1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY capture_fifo_read: 12 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/fifo/rg\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/fifo/rg1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY latency_capture_overrun: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/metadata_overrun_counter/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/metadata_overrun_counter/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY latency_missing_tags: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/missing_counter/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/missing_counter/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY latency_capture_overrun_pix: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/cam_overrun_counter/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/cam_overrun_counter/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY latency_select_overrun: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/select_overrun_counter/source_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/select_overrun_counter/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY latency_time_camera: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/diagnostic_timebase/time_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/capture/camera_clock_time/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_GRAY latency_time_display: 32 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^system_inst/diagnostic_timebase/time_gray\[[0-9]+(:[0-9]+)?\]$}] -to [get_cells -hierarchical -hsc / -regexp {^system_inst/display/diagnostics/pixel_clock_time/gray_sync1\[[0-9]+(:[0-9]+)?\]$}] 5.000
# CDC_BUNDLED latency_capture_metadata: 66 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^(?:system_inst/capture/capture_metadata_mailbox/held_data\[[0-9]+(:[0-9]+)?\]|system_inst/capture/capture_metadata_mailbox/request_toggle)$}] -to [get_cells -hierarchical -hsc / -regexp {^(?:system_inst/capture/capture_metadata_mailbox/destination_data\[[0-9]+(:[0-9]+)?\]|system_inst/capture/capture_metadata_mailbox/request_sync1)$}] 5.000
# CDC_BUNDLED latency_selected_metadata: 289 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^(?:system_inst/display/diagnostics/selected_mailbox/held_data\[[0-9]+(:[0-9]+)?\]|system_inst/display/diagnostics/selected_mailbox/request_toggle)$}] -to [get_cells -hierarchical -hsc / -regexp {^(?:system_inst/display/diagnostics/selected_mailbox/destination_data\[[0-9]+(:[0-9]+)?\]|system_inst/display/diagnostics/selected_mailbox/request_sync1)$}] 5.000
# CDC_BUNDLED latency_result_metadata: 513 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^(?:system_inst/display/diagnostics/result_mailbox/held_data\[[0-9]+(:[0-9]+)?\]|system_inst/display/diagnostics/result_mailbox/request_toggle)$}] -to [get_cells -hierarchical -hsc / -regexp {^(?:system_inst/display/diagnostics/result_mailbox/destination_data\[[0-9]+(:[0-9]+)?\]|system_inst/display/diagnostics/result_mailbox/request_sync1)$}] 5.000
# CDC_BUNDLED advanced_mode_commands: 4 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^(?:advanced_mode_mailbox/held_data\[[0-9]+(:[0-9]+)?\]|advanced_mode_mailbox/request_toggle)$}] -to [get_cells -hierarchical -hsc / -regexp {^(?:advanced_mode_mailbox/destination_data\[[0-9]+(:[0-9]+)?\]|advanced_mode_mailbox/request_sync1)$}] 5.000
# CDC_BUNDLED advanced_applied_status: 9 bits, max skew 5.000 ns
set_max_skew -from [get_cells -hierarchical -hsc / -regexp {^(?:advanced_status_mailbox/held_data\[[0-9]+(:[0-9]+)?\]|advanced_status_mailbox/request_toggle)$}] -to [get_cells -hierarchical -hsc / -regexp {^(?:advanced_status_mailbox/destination_data\[[0-9]+(:[0-9]+)?\]|advanced_status_mailbox/request_sync1)$}] 5.000
